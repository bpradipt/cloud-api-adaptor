#!/bin/bash
# kata-image-cache-setup
#
# Prepares the CDH layer store from pre-embedded OCI image layer directories.
#
# The layer directories live in the read-only squashfs rootfs at
# /usr/lib/kata-cache/layers/.  This script:
#   1. Copies meta_store.json to the CDH work directory (always first).
#   2. Creates a writable tmpfs layer store at the CDH layer path.
#   3. Bind-mounts each cached layer directory (read-only) from the squashfs
#      into the CDH layer store.
#
# No erofs mount is required — squashfs compression at build time makes erofs
# redundant, and removing it simplifies both the build and this boot script.

set -euo pipefail

CACHE_DIR=/usr/lib/kata-cache
META_STORE="${CACHE_DIR}/meta_store.json"

# CDH work directory paths (must match image-rs DEFAULT_WORK_DIR)
IMAGE_DIR=/run/kata-containers/image
LAYERS_DIR="${IMAGE_DIR}/layers"

# --- Step 1: copy meta_store.json FIRST ---
# Always done before any bind-mount so CDH gets a populated reference_db
# even if a layer bind-mount somehow fails.
mkdir -p "${IMAGE_DIR}"
cp "${META_STORE}" "${IMAGE_DIR}/meta_store.json"
echo "kata-image-cache: copied meta_store.json"

# --- Step 2: bind-mount each cached layer from squashfs ---
mkdir -p "${LAYERS_DIR}"

for layer_dir in "${CACHE_DIR}/layers"/*/; do
    layer_n=$(basename "${layer_dir}")
    target="${LAYERS_DIR}/${layer_n}"
    mkdir -p "${target}"
    mount --bind --make-private "${layer_dir%/}" "${target}"
    mount -o remount,ro,bind "${target}"
    echo "kata-image-cache: bound layer ${layer_n}"
done

echo "kata-image-cache: ready ($(ls "${LAYERS_DIR}" | wc -l) layers bound)"
