#!/bin/bash
# kata-image-cache-setup
#
# Prepares the CDH layer store for the pre-embedded OCI image cache.
#
# Strategy (bind-mount):
#   1. Copy meta_store.json to CDH work dir FIRST (always, regardless of mount).
#   2. Mount the erofs layer archive at a private location.
#   3. Create a writable tmpfs layer store at the CDH layer path.
#   4. Bind-mount each cached layer directory into the CDH layer store.
#
# Benefits over the previous direct-erofs-mount approach:
#   - meta_store.json is always present even if erofs mount fails.
#   - The CDH layer store dir (/run/kata-containers/image/layers) remains
#     writable on tmpfs, so CDH can create new layer dirs for other images
#     without hitting EROFS errors.
#   - Individual layer dirs are bind-mounted read-only from erofs; overlay
#     accepts bind-mounted dirs as valid lower-dir sources.
#   - Rollback (remove_dir_all) for a new network-pulled layer works because
#     it targets a fresh tmpfs sub-dir, not an erofs-backed path.

set -euo pipefail

CACHE_DIR=/usr/lib/kata-cache
EROFS_IMAGE="${CACHE_DIR}/layers.erofs"
META_STORE="${CACHE_DIR}/meta_store.json"

# Private erofs mount point (separate from CDH's layer store)
EROFS_MOUNT=/run/kata-cache-erofs

# CDH work directory paths (must match image-rs DEFAULT_WORK_DIR)
IMAGE_DIR=/run/kata-containers/image
LAYERS_DIR="${IMAGE_DIR}/layers"

# --- Step 1: copy meta_store.json FIRST ---
# Do this before anything that might fail so CDH always gets a populated store.
mkdir -p "${IMAGE_DIR}"
cp "${META_STORE}" "${IMAGE_DIR}/meta_store.json"
echo "kata-image-cache: copied meta_store.json to ${IMAGE_DIR}"

# --- Step 2: mount the erofs archive ---
mkdir -p "${EROFS_MOUNT}"
modprobe erofs 2>/dev/null || true

if ! mount -t erofs -o ro "${EROFS_IMAGE}" "${EROFS_MOUNT}"; then
    echo "kata-image-cache: WARNING: erofs mount failed; layer cache unavailable" >&2
    exit 0
fi
echo "kata-image-cache: erofs mounted at ${EROFS_MOUNT}"

# --- Step 3: create writable layer store and bind-mount each cached layer ---
mkdir -p "${LAYERS_DIR}"

for layer_dir in "${EROFS_MOUNT}"/*/; do
    layer_n=$(basename "${layer_dir}")
    target="${LAYERS_DIR}/${layer_n}"
    mkdir -p "${target}"
    mount --bind --make-private "${layer_dir%/}" "${target}"
    mount -o remount,ro,bind "${target}"
    echo "kata-image-cache: bind-mounted layer ${layer_n}"
done

echo "kata-image-cache: ready ($(ls "${LAYERS_DIR}" | wc -l) layers bound)"
